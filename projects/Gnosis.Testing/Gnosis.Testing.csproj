<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PackageId>Gnosis.Testing</PackageId>
    <Description>Gnosis 引擎测试框架，提供测试基类、Mock 工厂和测试工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="4.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gnosis\Gnosis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Network\NetworkManagerTests.cs" />
    <Compile Remove="Network\NetworkTests.cs" />
    <Compile Remove="Core\ConfigSystemTests.cs" />
  </ItemGroup>

</Project>
