    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0"/>
        <PackageReference Include="NUnit" Version="4.0.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gnosis.Core\Gnosis.Core.csproj"/>
        <ProjectReference Include="..\Gnosis.ECS\Gnosis.ECS.csproj"/>
        <ProjectReference Include="..\Gnosis.Network\Gnosis.Network.csproj"/>
        <ProjectReference Include="..\Gnosis.Security\Gnosis.Security.csproj"/>
        <ProjectReference Include="..\Gnosis.Testing\Gnosis.Testing.csproj"/>
    </ItemGroup>

</Project>
