        <PackageReference Include="ZstdNet" Version="1.4.5" />
        <PackageReference Include="NVorbis" Version="0.10.5" />
        <PackageReference Include="NAudio" Version="2.2.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gnosis.Core\Gnosis.Core.csproj" />
        <ProjectReference Include="..\..\..\Oak.cs\projects\Oak.Csv\Oak.Csv.csproj" />
        <ProjectReference Include="..\..\..\Oak.cs\projects\Oak.Obj\Oak.Obj.csproj" />
        <ProjectReference Include="..\..\..\Oak.cs\projects\Oak.Ktx\Oak.Ktx.csproj" />
    </ItemGroup>
</Project>
