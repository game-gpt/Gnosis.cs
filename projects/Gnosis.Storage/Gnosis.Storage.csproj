<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
        <PackageId>Gnosis.Storage</PackageId>
        <RootNamespace>Gnosis.Storage</RootNamespace>
        <Version>0.0.1</Version>
        <Authors>Gnosis Engine Team</Authors>
        <Description>Gnosis Storage - 基于 LightDB 的数据持久化抽象</Description>
        <PackageTags>gnosis;game-engine;storage;persistence;light-db</PackageTags>
        <RepositoryUrl>https://github.com/game-gpt/Gnosis.cs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gnosis.Database\Gnosis.Database.csproj" />
        <ProjectReference Include="..\Gnosis.ECS\Gnosis.ECS.csproj" />
        <ProjectReference Include="..\Gnosis.Security\Gnosis.Security.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\LightDB\projects\LightDB\LightDB.csproj" />
    </ItemGroup>
</Project>
