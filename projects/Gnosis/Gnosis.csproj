<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
        <PackageId>Gnosis</PackageId>
        <RootNamespace>Gnosis</RootNamespace>
        <Version>0.0.0</Version>
        <Authors>Gnosis Engine Team</Authors>
        <Description>Gnosis Engine Core Library - A multi-stage programming game engine with bytecode VM, ECS runtime, and compiler infrastructure</Description>
        <PackageTags>game-engine;gnosis;bytecode-vm;ecs;multi-stage-programming;hot-reload;cross-platform;compiler</PackageTags>
        <RepositoryUrl>https://github.com/game-gpt/Gnosis.cs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6"/>
        <PackageReference Include="NAudio" Version="2.2.1"/>
        <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8"/>
        <PackageReference Include="ZstdNet" Version="1.4.5"/>
    </ItemGroup>
</Project>
