<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gnosis</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PackageId>Gnosis</PackageId>
    <Version>0.0.0</Version>
    <Authors>Gnosis Engine Team</Authors>
    <Description>Gnosis Engine Core Library - A multi-stage programming game engine with bytecode VM, ECS runtime, and compiler infrastructure</Description>
    <PackageTags>game-engine;gnosis;bytecode-vm;ecs;multi-stage-programming;hot-reload;cross-platform;compiler</PackageTags>
    <RepositoryUrl>https://github.com/game-gpt/Gnosis.cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="ZstdNet" Version="1.4.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Editor\EditorWindow.cs" />
    <Compile Remove="Rendering\Renderer\SoftwareRenderer.cs" />
    <Compile Remove="Rendering\ShaderGenerator\GnosisShaderSourceGenerator.cs" />
    <Compile Remove="Compiler\AST\TypeExpressionStatement.cs" />
    <Compile Remove="Compiler\AST\TypeCallExpression.cs" />
    <Compile Remove="Assets\Formats\ConfigTables\**\*.cs" />
    <Compile Remove="ECS\Implementation\ComponentPool.cs" />
    <Compile Remove="ECS\Implementation\ComponentStorage.cs" />
    <Compile Remove="Rendering\ShaderCompiler\Backend\ShaderIR\TensorInstruction.cs" />
  </ItemGroup>

</Project>
