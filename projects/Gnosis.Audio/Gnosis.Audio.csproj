<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
        <PackageId>Gnosis.Audio</PackageId>
        <RootNamespace>Gnosis.Audio</RootNamespace>
        <Version>0.0.1</Version>
        <Authors>Gnosis Engine Team</Authors>
        <Description>Gnosis Audio - 音频播放、混音、3D 空间化</Description>
        <PackageTags>gnosis;game-engine;audio;sound;mixing;spatial</PackageTags>
        <RepositoryUrl>https://github.com/game-gpt/Gnosis.cs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Listener\AudioListenerComponent.cs" />
        <Compile Remove="Source\AudioSourceComponent.cs" />
    </ItemGroup>
</Project>
