<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>Gnosis.Core</PackageId>
        <RootNamespace>Gnosis.Core</RootNamespace>
        <Version>0.0.1</Version>
        <Authors>Gnosis Engine Team</Authors>
        <Description>Gnosis Core - 基础设施，零外部依赖，纯 C# 实现</Description>
        <PackageTags>gnosis;game-engine;core;infrastructure</PackageTags>
        <RepositoryUrl>https://github.com/game-gpt/Gnosis.cs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\SolidDB\projects\SolidDB\SolidDB.csproj" />
    </ItemGroup>
</Project>
